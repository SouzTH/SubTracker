# Copie este arquivo para ".env" e ajuste os valores antes de rodar o backend.
# O arquivo ".env" nunca deve ser commitado (já está no .gitignore).

# Qual implementação de repositório (acesso a dados) a aplicação usa.
# Hoje só existe "prisma" (PostgreSQL). A camada de repositório foi feita
# para que outra implementação (ex.: Mongoose/MongoDB) possa ser escolhida
# aqui, sem mudar controllers nem rotas — veja src/repositories/index.ts.
DB_DRIVER="prisma"

# PostgreSQL subindo pelo docker-compose.yml desta pasta ("npm run db:up").
# Usuário, senha e banco abaixo precisam bater com o docker-compose.yml.
DATABASE_URL="postgresql://subtracker:subtracker@localhost:5432/subtracker?schema=public"

# Segredo usado para assinar os tokens JWT. Gere um valor aleatório forte
# para produção — nunca use este exemplo de verdade.
JWT_SECRET="troque-este-valor-por-uma-string-aleatoria-longa"

# Por quanto tempo um token de login permanece válido.
JWT_EXPIRES_IN="7d"

# Porta em que a API vai escutar.
PORT=3001

# Origem do frontend, usada para configurar o CORS (o Vite roda em 5173 por padrão).
FRONTEND_URL="http://localhost:5173"
